{
  "name": "@viveeditor/vue",
  "version": "0.0.0",
  "description": "Vue 3 component for viveEditor with v-model, toolbar and every feature included.",
  "license": "MIT",
  "keywords": [
    "viveeditor",
    "rich-text-editor",
    "wysiwyg",
    "editor",
    "prosemirror",
    "vue",
    "vue3",
    "v-model"
  ],
  "homepage": "https://github.com/mtvrkan/viveeditor/tree/main/packages/vue#readme",
  "bugs": {
    "url": "https://github.com/mtvrkan/viveeditor/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mtvrkan/viveeditor.git",
    "directory": "packages/vue"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "size": "size-limit"
  },
  "dependencies": {
    "viveeditor": "workspace:^"
  },
  "devDependencies": {
    "@size-limit/preset-small-lib": "^14.3.0",
    "@vue/test-utils": "^2.5.1",
    "jsdom": "^30.1.3",
    "size-limit": "^14.3.0",
    "tsdown": "0.23.1",
    "vitest": "^5.0.5",
    "vue": "^3.5.44"
  },
  "size-limit": [
    {
      "name": "@viveeditor/vue",
      "path": "dist/index.js",
      "ignore": [
        "viveeditor",
        "vue"
      ],
      "limit": "1 KB"
    }
  ],
  "sideEffects": false,
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "engines": {
    "node": ">=22.12"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
