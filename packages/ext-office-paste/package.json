{
  "name": "@viveeditor/ext-office-paste",
  "version": "0.1.0",
  "description": "Clean paste from Word, Google Docs and LibreOffice for viveEditor, with real nested lists.",
  "license": "MIT",
  "keywords": [
    "viveeditor",
    "rich-text-editor",
    "wysiwyg",
    "editor",
    "prosemirror",
    "paste",
    "word",
    "google-docs",
    "libreoffice"
  ],
  "homepage": "https://github.com/mtvrkan/viveeditor/tree/main/packages/ext-office-paste#readme",
  "bugs": {
    "url": "https://github.com/mtvrkan/viveeditor/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mtvrkan/viveeditor.git",
    "directory": "packages/ext-office-paste"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "size": "size-limit"
  },
  "peerDependencies": {
    "@viveeditor/core": "workspace:^"
  },
  "dependencies": {
    "prosemirror-state": "^1.4.4"
  },
  "devDependencies": {
    "@size-limit/preset-small-lib": "^14.3.0",
    "@viveeditor/core": "workspace:*",
    "@viveeditor/ext-basic": "workspace:*",
    "@viveeditor/ext-list": "workspace:*",
    "fast-check": "^4.10.2",
    "jsdom": "^30.1.3",
    "prosemirror-view": "^1.42.7",
    "size-limit": "^14.3.0",
    "tsdown": "0.23.1",
    "vitest": "^5.0.5"
  },
  "size-limit": [
    {
      "name": "@viveeditor/ext-office-paste",
      "path": "dist/index.js",
      "ignore": [
        "@viveeditor/core",
        "prosemirror-keymap",
        "prosemirror-model",
        "prosemirror-state",
        "prosemirror-transform",
        "prosemirror-view"
      ],
      "limit": "3 KB"
    }
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22.12"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
