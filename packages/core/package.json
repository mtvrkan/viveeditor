{
  "name": "@viveeditor/core",
  "version": "0.0.0",
  "description": "Core engine of viveEditor, an open-source rich text editor.",
  "license": "MIT",
  "keywords": [
    "viveeditor",
    "rich-text-editor",
    "wysiwyg",
    "editor",
    "prosemirror",
    "contenteditable",
    "html-editor"
  ],
  "homepage": "https://github.com/mtvrkan/viveeditor/tree/main/packages/core#readme",
  "bugs": {
    "url": "https://github.com/mtvrkan/viveeditor/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mtvrkan/viveeditor.git",
    "directory": "packages/core"
  },
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./style.css": "./style.css"
  },
  "files": [
    "dist",
    "style.css"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "size": "size-limit"
  },
  "dependencies": {
    "prosemirror-commands": "^1.7.2",
    "prosemirror-history": "^1.5.1",
    "prosemirror-inputrules": "^1.5.1",
    "prosemirror-keymap": "^1.2.3",
    "prosemirror-model": "^1.25.12",
    "prosemirror-state": "^1.4.4",
    "prosemirror-transform": "^1.12.4",
    "prosemirror-view": "^1.42.7"
  },
  "devDependencies": {
    "@size-limit/preset-small-lib": "^14.3.0",
    "fast-check": "^4.10.2",
    "jsdom": "^30.1.3",
    "size-limit": "^14.3.0",
    "tsdown": "0.23.1",
    "vitest": "^5.0.5"
  },
  "size-limit": [
    {
      "name": "@viveeditor/core",
      "path": "dist/index.js",
      "limit": "60 KB"
    }
  ],
  "engines": {
    "node": ">=20.19"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
