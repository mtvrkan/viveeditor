{
  "name": "@viveeditor/ext-task-list",
  "version": "0.0.0",
  "description": "Task list (checklist) extension for viveEditor.",
  "license": "MIT",
  "keywords": [
    "viveeditor",
    "rich-text-editor",
    "wysiwyg",
    "editor",
    "prosemirror",
    "task-list",
    "checklist"
  ],
  "homepage": "https://github.com/mtvrkan/viveeditor/tree/main/packages/ext-task-list#readme",
  "bugs": {
    "url": "https://github.com/mtvrkan/viveeditor/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mtvrkan/viveeditor.git",
    "directory": "packages/ext-task-list"
  },
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./style.css": "./style.css"
  },
  "files": [
    "dist",
    "style.css"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "size": "size-limit"
  },
  "peerDependencies": {
    "@viveeditor/core": "workspace:^"
  },
  "dependencies": {
    "prosemirror-inputrules": "^1.5.1",
    "prosemirror-model": "^1.25.12",
    "prosemirror-schema-list": "^1.5.1",
    "prosemirror-state": "^1.4.4",
    "prosemirror-transform": "^1.12.4",
    "prosemirror-view": "^1.42.7"
  },
  "devDependencies": {
    "@size-limit/preset-small-lib": "^14.3.0",
    "@viveeditor/core": "workspace:*",
    "@viveeditor/ext-list": "workspace:*",
    "jsdom": "^30.1.3",
    "size-limit": "^14.3.0",
    "tsdown": "0.23.1",
    "vitest": "^5.0.5"
  },
  "size-limit": [
    {
      "name": "@viveeditor/ext-task-list",
      "path": "dist/index.js",
      "ignore": [
        "@viveeditor/core",
        "prosemirror-inputrules",
        "prosemirror-model",
        "prosemirror-schema-list",
        "prosemirror-state",
        "prosemirror-transform",
        "prosemirror-view"
      ],
      "limit": "2 KB"
    }
  ],
  "engines": {
    "node": ">=20.19"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
