{
  "name": "viveeditor-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.7",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "pnpm --filter @viveeditor/playground dev",
    "site": "pnpm --filter @viveeditor/site dev",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "turbo run typecheck && tsc -p tsconfig.json",
    "test": "turbo run test",
    "e2e": "playwright test",
    "size": "turbo run size",
    "check:packages": "node scripts/check-packages.mjs",
    "api:check": "node scripts/api-report.mjs check",
    "api:update": "node scripts/api-report.mjs update",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm size && pnpm api:check && pnpm check:packages && pnpm e2e",
    "changeset": "changeset"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@axe-core/playwright": "^4.14.0",
    "@biomejs/biome": "2.6.2",
    "@changesets/cli": "^3.0.3",
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.20.5",
    "publint": "^0.3.25",
    "turbo": "^2.11.10",
    "typescript": "^6.0.3"
  }
}
