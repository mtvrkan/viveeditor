{
  "name": "@viveeditor/element",
  "version": "0.0.0",
  "description": "<vive-editor> custom element for viveEditor: works in plain HTML forms and any framework.",
  "license": "MIT",
  "keywords": [
    "viveeditor",
    "rich-text-editor",
    "wysiwyg",
    "editor",
    "prosemirror",
    "web-component",
    "custom-element",
    "form"
  ],
  "homepage": "https://github.com/mtvrkan/viveeditor/tree/main/packages/element#readme",
  "bugs": {
    "url": "https://github.com/mtvrkan/viveeditor/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mtvrkan/viveeditor.git",
    "directory": "packages/element"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./define": {
      "types": "./dist/define.d.ts",
      "import": "./dist/define.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "size": "size-limit"
  },
  "dependencies": {
    "viveeditor": "workspace:^"
  },
  "devDependencies": {
    "@size-limit/preset-small-lib": "^14.3.0",
    "jsdom": "^30.1.3",
    "size-limit": "^14.3.0",
    "tsdown": "0.23.1",
    "vitest": "^5.0.5"
  },
  "size-limit": [
    {
      "name": "@viveeditor/element",
      "path": "dist/index.js",
      "ignore": [
        "viveeditor"
      ],
      "limit": "1.5 KB"
    }
  ],
  "sideEffects": [
    "./dist/define.js"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
