{
  "name": "@viveeditor/ui",
  "version": "0.1.0",
  "description": "Floating toolbar, selection bubble, slash menu, link panel and readability meter for viveEditor.",
  "license": "MIT",
  "keywords": [
    "viveeditor",
    "rich-text-editor",
    "wysiwyg",
    "editor",
    "prosemirror",
    "toolbar",
    "slash-menu",
    "readability",
    "accessibility"
  ],
  "homepage": "https://github.com/mtvrkan/viveeditor/tree/main/packages/ui#readme",
  "bugs": {
    "url": "https://github.com/mtvrkan/viveeditor/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mtvrkan/viveeditor.git",
    "directory": "packages/ui"
  },
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./extras": {
      "types": "./dist/extras/index.d.ts",
      "import": "./dist/extras/index.js"
    },
    "./panels": {
      "types": "./dist/panel-kit.d.ts",
      "import": "./dist/panel-kit.js"
    },
    "./style.css": "./style.css"
  },
  "files": [
    "dist",
    "style.css"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "size": "size-limit"
  },
  "peerDependencies": {
    "@viveeditor/core": "workspace:^"
  },
  "devDependencies": {
    "@size-limit/preset-small-lib": "^14.3.0",
    "@viveeditor/core": "workspace:*",
    "@viveeditor/ext-basic": "workspace:*",
    "@viveeditor/ext-character-count": "workspace:*",
    "@viveeditor/ext-code-block": "workspace:*",
    "@viveeditor/ext-embed": "workspace:*",
    "@viveeditor/ext-footnote": "workspace:*",
    "@viveeditor/ext-format": "workspace:*",
    "@viveeditor/ext-image": "workspace:*",
    "@viveeditor/ext-list": "workspace:*",
    "@viveeditor/ext-math": "workspace:*",
    "@viveeditor/ext-mention": "workspace:*",
    "@viveeditor/ext-search": "workspace:*",
    "@viveeditor/ext-table": "workspace:*",
    "@viveeditor/ext-task-list": "workspace:*",
    "jsdom": "^30.1.3",
    "size-limit": "^14.3.0",
    "tsdown": "0.23.1",
    "vitest": "^5.0.5"
  },
  "size-limit": [
    {
      "name": "@viveeditor/ui",
      "path": "dist/index.js",
      "ignore": [
        "@viveeditor/core",
        "./panel-kit.js"
      ],
      "limit": "20 KB"
    },
    {
      "name": "@viveeditor/ui panels (loaded on first panel open)",
      "path": "dist/panel-kit.js",
      "ignore": [
        "@viveeditor/core"
      ],
      "limit": "5.5 KB"
    },
    {
      "name": "@viveeditor/ui/extras",
      "path": "dist/extras/index.js",
      "ignore": [
        "@viveeditor/core"
      ],
      "limit": "9 KB"
    }
  ],
  "engines": {
    "node": ">=22.12"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
