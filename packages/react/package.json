{
  "name": "@viveeditor/react",
  "version": "0.0.0",
  "description": "React component for viveEditor with value/onChange, toolbar and every feature included.",
  "license": "MIT",
  "keywords": [
    "viveeditor",
    "rich-text-editor",
    "wysiwyg",
    "editor",
    "prosemirror",
    "react",
    "react-component"
  ],
  "homepage": "https://github.com/mtvrkan/viveeditor/tree/main/packages/react#readme",
  "bugs": {
    "url": "https://github.com/mtvrkan/viveeditor/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mtvrkan/viveeditor.git",
    "directory": "packages/react"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "size": "size-limit"
  },
  "dependencies": {
    "viveeditor": "workspace:^"
  },
  "devDependencies": {
    "@size-limit/preset-small-lib": "^14.3.0",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^30.1.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "size-limit": "^14.3.0",
    "tsdown": "0.23.1",
    "vitest": "^5.0.5"
  },
  "size-limit": [
    {
      "name": "@viveeditor/react",
      "path": "dist/index.js",
      "ignore": [
        "viveeditor",
        "react"
      ],
      "limit": "1 KB"
    }
  ],
  "sideEffects": false,
  "peerDependencies": {
    "react": "^18.3.0 || ^19.0.0"
  },
  "engines": {
    "node": ">=20.19"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
