{
  "name": "viveeditor/laravel",
  "description": "viveEditor for Laravel: a Blade editor component, local assets and server-side HTML cleaning.",
  "type": "library",
  "license": "MIT",
  "keywords": ["laravel", "blade", "wysiwyg", "rich-text-editor", "editor", "viveeditor"],
  "homepage": "https://github.com/mtvrkan/viveeditor/tree/main/integrations/laravel#readme",
  "support": {
    "issues": "https://github.com/mtvrkan/viveeditor/issues",
    "source": "https://github.com/mtvrkan/viveeditor/tree/main/integrations/laravel",
    "security": "https://github.com/mtvrkan/viveeditor/security/policy"
  },
  "require": {
    "php": ">=8.4",
    "illuminate/support": "^12.0 || ^13.0",
    "illuminate/view": "^12.0 || ^13.0",
    "illuminate/database": "^12.0 || ^13.0",
    "viveeditor/sanitizer": "^0.1"
  },
  "require-dev": {
    "orchestra/testbench": "^10.0 || ^11.0"
  },
  "repositories": [
    {
      "type": "path",
      "url": "../../php/sanitizer",
      "options": {
        "symlink": true,
        "versions": {
          "viveeditor/sanitizer": "0.1.0"
        }
      }
    }
  ],
  "autoload": {
    "psr-4": {
      "Viveeditor\\Laravel\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Viveeditor\\Laravel\\Tests\\": "tests/"
    }
  },
  "extra": {
    "laravel": {
      "providers": ["Viveeditor\\Laravel\\ViveEditorServiceProvider"],
      "aliases": {
        "ViveEditor": "Viveeditor\\Laravel\\Facades\\ViveEditor"
      }
    }
  },
  "config": {
    "allow-plugins": {},
    "sort-packages": true,
    "policy": {
      "cooldown": {
        "period": "7 days",
        "ignore": ["symfony/mime"]
      }
    }
  }
}
